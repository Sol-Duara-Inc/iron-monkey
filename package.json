{
  "name": "iron-monkey",
  "version": "0.6.0",
  "description": "A CDEvents pitching machine for testing SDLC orchestration platforms",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "iron-monkey": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint src tests bench",
    "lint:fix": "eslint src tests bench --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "bench": "tsx bench/run.ts"
  },
  "keywords": [
    "cdevents",
    "cdcon",
    "sdlc",
    "chaos",
    "testing",
    "rabbitmq",
    "kafka"
  ],
  "author": "Sol Duara",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "amqplib": "^0.10.4",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "msw": "^2.6.8",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}