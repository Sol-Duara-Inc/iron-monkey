{
  "conduit": {
    "url": "http://localhost:8080",
    "token": "${CONDUIT_TOKEN}"
  },
  "buses": {
    "conduit": {
      "type": "junction-box",
      "url": "http://localhost:8080",
      "events_path": "/api/v1/events",
      "health_check": false,
      "launch": false,
      "expected_status": 202,
      "headers": {
        "X-API-Key": "${CONDUIT_TOKEN}"
      }
    }
  },
  "defaults": {
    "source": "https://iron-monkey.example.com/"
  },
  "tools": {
    "gke-prod": { "source": "https://gke.example.com/" },
    "jenkins-prod": { "source": "https://jenkins.example.com/" },
    "security-scanner": { "source": "https://snyk.example.com/" },
    "spinnaker-prod": { "source": "https://spinnaker.example.com/" }
  }
}
